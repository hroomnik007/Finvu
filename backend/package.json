{
  "name": "finance-tracker-backend",
  "version": "1.0.0",
  "description": "Finance Tracker API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:setup": "tsx src/scripts/baseline.ts && tsx src/scripts/migrate.ts",
    "db:check-schema": "tsx src/scripts/check-schema.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed-dev-user": "tsx src/scripts/seed-dev-user.ts",
    "seed-categories": "tsx src/scripts/seed-categories.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.25.4"
  }
}
