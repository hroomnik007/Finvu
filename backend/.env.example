DATABASE_URL=postgresql://user:password@postgres:5432/finance_tracker
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-at-least-32-chars
JWT_ADMIN_SECRET=replace-with-a-third-random-string-of-at-least-32-characters
PORT=3001
# Use "production" on the server: it enables secure cookies and the production CORS origin.
NODE_ENV=development
BCRYPT_ROUNDS=12
ADMIN_USERNAME=admin
# At least 12 characters
ADMIN_PASSWORD=replace-with-a-long-admin-password

# Public URL of the frontend (used in e-mail links and as the WebAuthn defaults)
APP_URL=http://localhost:5173

# Required for Google sign-in — without it the endpoint answers 503.
# GOOGLE_CLIENT_ID=
# Optional WebAuthn overrides (default to the host/origin of APP_URL)
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=
